{
  "index_patterns": ["dev-admin-auth-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "logger_name": {
          "type": "keyword",
          "index": false
        },
        "thread_name": {
          "type": "keyword",
          "index": false
        },
        "event": {
          "type": "keyword"
        },
        "ipAddress": {
          "type": "ip",
          "index": false
        },
        "user": {
          "type": "keyword"
        }
      }
    }
  }
}