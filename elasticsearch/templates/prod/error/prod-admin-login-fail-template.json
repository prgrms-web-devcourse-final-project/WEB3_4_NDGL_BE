{
  "index_patterns": ["prod-admin-login-fail-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "logger_name": {
          "type": "keyword",
          "index": false
        },
        "thread_name": {
          "type": "keyword",
          "index": false
        },
        "stack_trace": {
          "type": "text",
          "index": false
        },
        "ipAddress": {
          "type": "ip"
        },
        "userAgent": {
          "type": "keyword"
        }
      }
    }
  }
}