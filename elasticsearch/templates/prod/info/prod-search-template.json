{
  "index_patterns": ["prod-search-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "analysis": {
        "tokenizer": {
          "nori_user_noun_tokenizer": {
            "type": "nori_tokenizer",
            "decompound_mode": "mixed",
            "discard_punctuation": "true"
          }
        },
        "filter": {
          "nori_only_nouns_filter": {
            "type": "nori_part_of_speech",
            "stoptags": [
              "E",
              "IC",
              "J",
              "MAG",
              "MAJ",
              "MM",
              "SP",
              "SSC",
              "SSO",
              "SC",
              "SE",
              "XPN",
              "XSA",
              "XSN",
              "XSV",
              "UNA",
              "NA",
              "VSV"
            ]
          }
        },
        "analyzer": {
          "nori_nouns_join_analyzer": {
            "type": "custom",
            "tokenizer": "nori_user_noun_tokenizer",
            "filter": [
              "nori_only_nouns_filter",
              "lowercase"
            ],
            "char_filter": []
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "logger_name": {
          "type": "keyword",
          "index": false
        },
        "thread_name": {
          "type": "keyword",
          "index": false
        },
        "keyword": {
          "type": "text",
          "analyzer": "nori_nouns_join_analyzer",
          "fields": {
            "joined": {
              "type": "keyword",
              "normalizer": "lowercase"
            }
          }
        },
        "ipAddress": {
          "type": "ip",
          "index": false
        },
        "userAgent": {
          "type": "keyword",
          "index": false
        }
      }
    }
  }
}
