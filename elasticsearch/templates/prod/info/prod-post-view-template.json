{
  "index_patterns": ["prod-post-view-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "logger_name": {
          "type": "keyword",
          "index": false
        },
        "thread_name": {
          "type": "keyword",
          "index": false
        },
        "postId": {
          "type": "integer"
        },
        "ipAddress": {
          "type": "ip",
          "index": false
        },
        "userAgent": {
          "type": "keyword",
          "index": false
        }
      }
    }
  }
}